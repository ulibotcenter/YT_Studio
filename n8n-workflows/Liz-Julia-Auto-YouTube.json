{
  "name": "Liz & Julia - Explora Cultura Infantil (Auto)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "id": "monitor-videos",
      "name": "Monitora Pasta de Vídeos",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 2,
      "position": [250, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "operation": "read",
        "path": "/Videos/LizJulia",
        "options": {
          "recursive": true,
          "include": ["*.mp4", "*.mov"]
        }
      },
      "id": "read-files",
      "name": "Lê arquivos novos",
      "type": "n8n-nodes-base.readDir",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "transcribe",
        "model": "whisper"
      },
      "id": "transcribe",
      "name": "Transcreve + Resumo (estilo Liz e Julia)",
      "type": "n8n-nodes-base.whisper",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "systemMessage": "Você é especialista em conteúdo infantil brasileiro. Analise os vídeos de Liz (10 anos, mais leve e madura) e Julia (7 anos, mais fofa). Mantenha sempre: humor infantil natural, ritmo rápido, português do Brasil, temas de cultura geral (história, ciência, curiosidades, viagens, cultura pop). Gere roteiro completo, voz em off infantil, legendas sincronizadas em PT-BR, EN e ES. Use o perfil JSON fixo (que você vai criar depois) e os vídeos antigos do canal como exemplo. O vídeo deve ter título e descrição profissionais para gerar renda (comentar com parentes), sem marcar como canal infantil puro.",
      },
      "id": "gera-roteiro",
      "name": "Gera Roteiro + Legenda Multilingue",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 2,
      "position": [850, 300],
      "credentials": {
        "openAIApi": "OpenAI"
      }
    },
    {
      "parameters": {
        "operation": "voiceover",
        "text": "={{ $node['Gera Roteiro + Legenda Multilingue'].json.text }}",
        "voice": "alloy"
      },
      "id": "voz-off",
      "name": "Gera Voz em Off",
      "type": "n8n-nodes-base.elevenlabs",
      "typeVersion": 1,
      "position": [1050, 300],
      "credentials": {
        "elevenlabsApi": "ElevenLabs"
      }
    },
    {
      "parameters": {
        "operation": "edit",
        "provider": "ffmpeg",
        "action": "auto-edit",
        "duration": 300
      },
      "id": "edita-video",
      "name": "Edita com FFmpeg + CapCut CLI (Mac)",
      "type": "n8n-nodes-ffmpeg",
      "typeVersion": 1,
      "position": [1250, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "operation": "generate",
        "model": "flux",
        "prompt": "Thumbnail profissional para vídeo de Liz & Julia: {{ $node['Gera Roteiro + Legenda Multilingue'].json.title }} - cultura infantil, humor leve, cores vibrantes, logo das meninas",
        "width": 1280,
        "height": 720
      },
      "id": "thumbnail",
      "name": "Gera Thumbnail com IA",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "chatId": "SEU_CHAT_ID_DO_TELEGRAM_AQUI",
        "text": "📹 Novo vídeo pronto!\n\n{{ $node['Gera Roteiro + Legenda Multilingue'].json.title }}\n\nDuração: {{ $node['Edita com FFmpeg + CapCut CLI (Mac)'].json.duration || 'Calculando...' }}\n\nVoz em off infantil natural\nLegendas PT-BR / EN / ES\n\nAprova para postar agora? (Sim / Não)",
        "parseMode": "MarkdownV2",
        "buttons": {
          "inline": [
            [
              {
                "text": "✅ Aprovar postar",
                "callback": "APPROVE"
              },
              {
                "text": "❌ Rejeitar",
                "callback": "REJECT"
              }
            ]
          ]
        }
      },
      "id": "telegram-approval",
      "name": "Envio para Aprovação (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "title": "={{ $node['Gera Roteiro + Legenda Multilingue'].json.title }}",
        "description": "={{ $node['Gera Roteiro + Legenda Multilingue'].json.description }}",
        "privacy": "public",
        "tags": "liz-julia-kids, cultura infantil, historia, ciencia, curiosidades, pt-br, madrid, monetize, family culture, parenting, curiozidades"
      },
      "id": "upload-youtube",
      "name": "Faz Upload no YouTube",
      "type": "n8n-nodes-multi-upload-tool",
      "typeVersion": 1,
      "position": [1650, 300]
    }
  ],
  "connections": {
    "Monitora Pasta de Vídeos": {
      "main": [[{ "node": "read-files", "type": "main", "index": 0 }]]
    },
    "Lê arquivos novos": {
      "main": [[{ "node": "transcribe", "type": "main", "index": 0 }]]
    },
    "Transcreve + Resumo": {
      "main": [[{ "node": "gera-roteiro", "type": "main", "index": 0 }]]
    },
    "Gera Roteiro + Legenda Multilingue": {
      "main": [[{ "node": "voz-off", "type": "main", "index": 0 }], [{ "node": "edita-video", "type": "main", "index": 0 }]]
    },
    "Gera Voz em Off": {
      "main": [[{ "node": "edita-video", "type": "main", "index": 1 }]]
    },
    "Edita com FFmpeg + CapCut CLI (Mac)": {
      "main": [[{ "node": "telegram-approval", "type": "main", "index": 0 }]]
    },
    "Envio para Aprovação (Telegram)": {
      "main": [[{ "node": "upload-youtube", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "timezone": "Europe/Madrid"
  }
}
